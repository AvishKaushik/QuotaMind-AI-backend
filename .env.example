# ── App ────────────────────────────────────────────────────────
APP_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:3000

# ── MongoDB Atlas ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=quotamind

# ── Redis (Redis Cloud or local docker) ────────────────────────
REDIS_URL=redis://localhost:6379

# ── Google Gemini (AI Studio key) ──────────────────────────────
GEMINI_API_KEY=
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash

# ── Google Cloud Agent Builder (Vertex AI / Dialogflow CX) ─────
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
AGENT_BUILDER_AGENT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ── Dynatrace (REST transport — .live. host + API token) ──────
DYNATRACE_ENV_URL=https://xxxxx.live.dynatrace.com
DYNATRACE_API_TOKEN=

# ── Dynatrace MCP (real MCP server — .apps. host + platform token) ─
# Platform token (dt0s16...) needs Grail scopes: storage:events:read,
# storage:buckets:read, storage:metrics:read, storage:logs:read,
# storage:entities:read, app-engine:apps:run, app-engine:functions:run
DT_PLATFORM_TOKEN=
DT_ENVIRONMENT=https://xxxxx.apps.dynatrace.com
# Optional: override the npm package spec the MCP client launches via npx
# DT_MCP_PACKAGE=@dynatrace-oss/dynatrace-mcp-server@1.8.7

# ── Quota / budget defaults ────────────────────────────────────
DAILY_QUOTA_TOKEN_LIMIT=10000000
DAILY_BUDGET_USD=500
ORCHESTRATOR_INTERVAL_SECONDS=30
# Set false to boot the API without the autonomous 30s agent loop
ORCHESTRATOR_AUTOSTART=true

# Event bus
EVENTS_CHANNEL=quotamind:events
